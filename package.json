{
  "name": "nasdaq-pages",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "check": "node scripts/check-pages.mjs && node scripts/check-calendar.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "collect": "node scripts/collect-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.12"
  }
}
